Screen {
    layout: vertical;
}

#status {
    height: 1;
    padding: 0 1;
    background: $boost;
}

#fleet {
    height: 3;
    max-height: 12;
    margin: 0 0 1 0;
    border-bottom: solid $primary-darken-2;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

/* --- vehicle tab -------------------------------------------------------- */

#vehicle-top {
    height: auto;
    max-height: 20;
}

#telemetry {
    width: 1fr;
    height: auto;
    min-height: 12;
    padding: 1 2;
    border: round $primary-darken-1;
}

#controls {
    width: 36;
    height: auto;
    padding: 0 1;
}

#controls .row {
    height: auto;
    margin-bottom: 1;
}

#controls Button {
    width: 1fr;
    min-width: 8;
    margin-right: 1;
}

#takeoff-alt {
    width: 10;
    margin-right: 1;
}

#mode {
    width: 100%;
    margin-bottom: 1;
}

#command {
    margin: 1 0 0 0;
}

#vehicle-log {
    height: 1fr;
    border: round $panel-lighten-1;
}

/* --- logs tab ----------------------------------------------------------- */

#log-bar {
    height: auto;
    margin-bottom: 1;
}

#log-bar Label {
    padding: 0 1 0 3;
    content-align: center middle;
    height: 1;
}

#log-source {
    width: 32;
}

#log-bar Button {
    margin-left: 2;
}

#log {
    height: 1fr;
    border: round $panel-lighten-1;
}

/* --- ports tab ---------------------------------------------------------- */

#preflight {
    height: auto;
    padding: 1 0;
}

#ports {
    height: 1fr;
}

/* --- scenario tab ------------------------------------------------------- */

#scenario-form {
    height: 1fr;
}

#scenario-form .form {
    width: 50;
    height: auto;
    padding-right: 2;
}

#scenario-form .form Label {
    margin-top: 1;
    color: $text-muted;
}

#scenario-form .row {
    height: auto;
    margin-top: 1;
}

#scenario-form .row Label {
    margin: 0 1;
    content-align: center middle;
    height: 3;
}

#sc-yaml {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    border: round $panel-lighten-1;
    overflow-y: auto;
}

/* --- dialogs ------------------------------------------------------------ */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.dialog.compact Label {
    margin-top: 0;
}

.dialog.compact .switch-row {
    margin-top: 0;
}

.dialog.narrow {
    width: 56;
}

.dialog.wide {
    width: 110;
}

.dialog Label {
    margin-top: 1;
    color: $text-muted;
}

.dialog .dialog-title {
    text-style: bold;
    color: $text;
    margin: 0 0 1 0;
}

.switch-row {
    height: auto;
    margin-top: 1;
}

.switch-row Label {
    margin: 0 1;
    height: 3;
    content-align: left middle;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.dialog-buttons Button {
    margin-left: 1;
}

#doctor {
    height: auto;
    max-height: 24;
}

.hint {
    height: auto;
    margin-top: 1;
    color: $warning;
}

/* --- ports tab editor / camera dialog ------------------------------------ */

#ports-pane {
    height: 1fr;
}

.section {
    text-style: bold;
    margin: 1 2 0 0;
    height: 1;
}

.section-bar {
    height: auto;
}

.section-bar Button {
    margin: 1 1 0 0;
}

#outputs {
    height: auto;
    max-height: 14;
}

#ports {
    height: auto;
}

#video {
    height: auto;
    max-height: 12;
}

.hint-text {
    height: auto;
    color: $text-muted;
    margin: 1 0;
}

.field-row {
    height: auto;
    margin-top: 1;
}

.field-row Label {
    margin: 0 1 0 0;
    padding-top: 0;
    width: auto;
}

.field-row Input {
    width: 10;
    margin-right: 2;
}

.field-row Select {
    width: 1fr;
    margin-right: 2;
}

#host {
    width: 18;
}

#preview {
    height: auto;
    margin-top: 1;
}

.camera-dialog {
    height: 90%;
}

#snippet-box {
    height: 1fr;
    border: round $panel-lighten-1;
    padding: 0 1;
    margin-top: 1;
}

#world-create {
    margin-top: 1;
    width: 100%;
}

#world-problem {
    height: auto;
}
